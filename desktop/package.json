{
  "name": "data-migrator",
  "productName": "Data Migrator",
  "version": "0.1.2",
  "description": "Inspect legacy table files and migrate data between MySQL, MongoDB, PostgreSQL, Microsoft SQL Server and Redis",
  "author": "furaiwave",
  "private": true,
  "license": "UNLICENSED",
  "main": "main.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node scripts/start.mjs",
    "dist": "node scripts/build.mjs && electron-builder --win --publish never",
    "icons": "node scripts/make-icons.mjs"
  },
  "build": {
    "appId": "dev.furaiwave.dbf-inspector",
    "productName": "Data Migrator",
    "directories": {
      "output": "out"
    },
    "files": [
      "main.cjs",
      "app/**/*",
      "assets/icon.ico",
      "assets/icon.png",
      "package.json",
      "!app/native/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Data Migrator",
      "artifactName": "data-migrator-setup-${version}.${ext}",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico"
    },
    "portable": {
      "artifactName": "data-migrator-${version}-portable.${ext}"
    },
    "extraResources": [
      {
        "from": "app/native",
        "to": "native",
        "filter": [
          "**/*"
        ]
      }
    ]
  },
  "devDependencies": {
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2"
  }
}
